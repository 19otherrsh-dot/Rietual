# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ritual:ritual@localhost:5432/ritual

# ─── Valkey (Celery broker + cache) ────────────────────────────────────────────
VALKEY_URL=valkey://localhost:6379/0

# ─── Auth — Ory Kratos ─────────────────────────────────────────────────────────
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

# Dev bypass: set to true to skip Kratos and pass X-Dev-User-Id header directly.
# NEVER enable in production.
DEV_AUTH_BYPASS=true

# ─── Push Notifications — APNs (iOS) ───────────────────────────────────────────
# Direct APNs over HTTP/2 — no Firebase, no OneSignal (STACK §2)
APNS_KEY_ID=YOUR_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_BUNDLE_ID=com.yourcompany.ritual
APNS_PRIVATE_KEY_PATH=./secrets/apns_auth_key.p8
APNS_SANDBOX=true            # false in production

# ─── Push Notifications — FCM (Android) ────────────────────────────────────────
# HTTP v1 API only — no Firebase SDK embedded in client (STACK §2)
FCM_SERVICE_ACCOUNT_JSON_PATH=./secrets/fcm_service_account.json

# ─── Celery beat ───────────────────────────────────────────────────────────────
# All schedules are defined in src/workers/celery_app.py
# Set timezone to UTC; occurrences use per-user IANA tz (Habit Engine §4.2)
CELERY_TIMEZONE=UTC
